	username = mrmicahcooper
[commit]
  gpgsign = true
[gpg "ssh"]
  program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
[gpg]
  format = ssh
[branch]
  autosetuprebase = always
[color]
  ui = auto
[core]
  excludesfile = ~/.cvsignore
  editor = nvim
  whitespace = warn
[help]
  autocorrect = 10
[interactive]
  singlekey = true
[merge]
  summary = true
[merge "bundlelock"]
  name = lock Gemfile
  driver = bundle install
[merge "bundle"]
  name = bundle
  driver = bundle
[push]
  default = tracking
[rebase]
  autosquash = true
[diff]
  algorithm = patience
[fetch]
  prune = true
[init]
	defaultBranch = main
[advice]
	statushints = false
[safe]
	directory = *
[url "ssh://git@github.com/"]
  insteadOf = https://github.com/
[alias]
  aliases=!git config -l | grep '^alias' | cut -c 7- | sort
  b  = branch
  br = branch
  co = checkout
  fixup = commit --fixup
  tree = log --graph --oneline --decorate --color --all
