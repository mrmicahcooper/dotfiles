# ~/.bashrc
#
use_color=true

eval "$(mise activate bash)"

# shell options
shopt -s checkwinsize
shopt -s expand_aliases
shopt -s histappend

source ~/.posix_export
source ~/.posix_alias
source ~/.posix_functions

[ -f ~/.fzf.bash ] && source ~/.fzf.bash
[ -f ~/.git-completion.bash ] && source ~/.git-completion.bash

eval "$(starship init bash)"
